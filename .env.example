# Server Environment Configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection String
# Local: mongodb://localhost:27017/qubtic
# Production (MongoDB Atlas): mongodb+srv://<user>:<password>@cluster0.mongodb.net/qubtic?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/qubtic
MONGODB_DB_NAME=qubtic

# JWT Secret for Session Authentication
JWT_SECRET=qubtic_secret_jwt_key_change_in_production_2026

# Mailgun SMTP Configuration
# Settings URL: https://app.mailgun.com/mg/sending/qubtic.tech/settings?tab=settings
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM="FrameKit by Qubtic" <noreply@qubtic.tech>

# Qubtic Team Notification Email (receives alerts when new users sign up)
TEAM_NOTIFICATION_EMAIL=qubticpro@gmail.com

# Allowed Origins for CORS
CLIENT_ORIGIN=http://localhost:5173
