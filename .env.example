# Server Environment Configuration
PORT=4000
NODE_ENV=development

# Supabase PostgreSQL Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Service Role key (recommended for server operations - bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
# Anon Public key (optional alternative)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# JWT Secret for Session Authentication
JWT_SECRET=qubtic_secret_jwt_key_change_in_production_2026

# Mailgun SMTP Configuration
# Settings URL: https://app.mailgun.com/mg/sending/qubtic.tech/settings?tab=settings
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM="FrameKit by Qubtic" <noreply@qubtic.com>

# Qubtic Team Notification Email (receives alerts when new users sign up)
TEAM_NOTIFICATION_EMAIL=hello@qubtic.com

# Allowed Origins for CORS
CLIENT_ORIGIN=http://localhost:5173
